name: Generate Gradle Wrapper JAR

on:
  workflow_dispatch:

jobs:
  generate:
    runs-on: ubuntu-latest

    steps:
      - name: Set up Java 8
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '8'

      - name: Download Gradle 2.14.1
        run: |
          curl -fL https://services.gradle.org/distributions/gradle-2.14.1-bin.zip -o "$RUNNER_TEMP/gradle.zip"
          unzip -q "$RUNNER_TEMP/gradle.zip" -d "$RUNNER_TEMP"

      - name: Generate Wrapper JAR
        run: |
          mkdir -p "$RUNNER_TEMP/wrapper-project"
          cd "$RUNNER_TEMP/wrapper-project"
          touch build.gradle
          "$RUNNER_TEMP/gradle-2.14.1/bin/gradle" wrapper --gradle-version 2.14.1 --distribution-type bin

      - name: Upload Wrapper JAR
        uses: actions/upload-artifact@v4
        with:
          name: gradle-wrapper-jar
          path: ${{ runner.temp }}/wrapper-project/gradle/wrapper/gradle-wrapper.jar
